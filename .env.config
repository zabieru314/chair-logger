# 設定値（git管理対象。秘密情報は .env に記載）
# SUMMARY_WEBHOOK_URL は .env にのみ記載（git管理外）
SUMMARY_TIME=22:00

VARIANCE_THRESHOLD=0.04
DAILY_GOAL_MINUTES=360
SEATED_CONFIRM_WINDOW_SEC=300
MAX_TEMP_CELSIUS=40.0
DEBOUNCE_DELAY_SEC=5
DEBOUNCE_LEFT_SEC=600
COOLDOWN_SLEEP_SEC=300
TEMP_CHECK_INTERVAL_SEC=60
SENSOR_POLL_INTERVAL_SEC=30

FLASK_HOST=0.0.0.0
FLASK_PORT=8080

DB_PATH=data/chair_log.db
LOG_PATH=logs/app.log
