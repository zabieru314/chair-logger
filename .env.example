# ===============================
# 着席検知システム 環境変数サンプル
# ===============================
# このファイルは git にコミットしてOK（実際の秘匿値は .env に書く）

# Webhook通知先URL（Discord / Slack / Teams など）
WEBHOOK_URL=https://discord.com/api/webhooks/xxxxxx/xxxxxxxx

# 振動検知の閾値
# スマホをクッションの下に置き、加速度magnitude（√(x²+y²+z²)）の
# 直近約10秒分の標準偏差がこの値以上なら「振動あり=着席中」とみなす。
# 静止した机の上だと0.01〜0.05程度、人が座って体動するクッションだと0.3〜数程度。
VIBRATION_THRESHOLD=0.3

# 温度上限（バッテリー温度・摂氏）
# この値を超えるとセンサー監視を一時休止する
MAX_TEMP_CELSIUS=40.0

# Debounce（チャタリング対策）猶予時間（秒）
# 状態が変化してからこの秒数だけ継続したら確定とみなす
DEBOUNCE_DELAY_SEC=5

# 温度オーバー時の休止時間（秒）
COOLDOWN_SLEEP_SEC=300

# 温度監視の確認間隔（秒）
TEMP_CHECK_INTERVAL_SEC=60

# Flask Webサーバー設定
FLASK_HOST=0.0.0.0
FLASK_PORT=8080

# DBファイルパス（プロジェクトルートからの相対パス）
DB_PATH=data/chair_log.db

# ログファイルパス
LOG_PATH=logs/app.log

# termux-sensor の取得間隔（ミリ秒）
# ※ Popen でストリーム読み取りするため、これは termux-sensor 側のサンプリング間隔
# 振動検知では500ms × 20サンプル ≒ 10秒分のmagnitudeから標準偏差を算出する
SENSOR_INTERVAL_MS=500
